<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="/workspace/Code2/real_data/CSeditClean_1.net_threelegs.xml" />
        <route-files value="/workspace/Code2/real_data/newroute1220_start0.xml" />
        
	
    </input>

    <processing>
        <ignore-route-errors value="true" />
    </processing>

    <report>
        <verbose value="true" />
        <duration-log.statistics value="true" />
        <no-step-log value="true" />
    </report>

    <gui_only>
        <gui-settings-file value="/workspace/Code2/real_data/osm.view.xml" />
    </gui_only>
    <random>
        <seed value="8" />
    </random>

</configuration>